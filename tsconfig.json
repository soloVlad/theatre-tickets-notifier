{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@bot/*": ["./src/bot/*"],
      "@bot": ["./src/bot/index.ts"],
      "@checks/*": ["./src/checks/*"],
      "@checks": ["./src/checks/index.ts"],
      "@config/*": ["./src/config/*"],
      "@config": ["./src/config/index.ts"],
      "@db/*": ["./src/db/*"],
      "@db": ["./src/db/index.ts"],
      "@util/*": ["./src/util/*"],
      "@util": ["./src/util/index.ts"],
    }
  },
  "include": [
    "src"
  ]
}
